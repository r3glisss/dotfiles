# Enhanced extract function
extract() {
    if [[ $# -eq 0 ]]; then
        echo "Usage: extract <archive_file>"
        return 1
    fi

    for file in "$@"; do
        if [[ ! -f "$file" ]]; then
            echo "Error: '$file' is not a valid file"
            continue
        fi

        case "${file:l}" in
            *.tar.bz2|*.tbz2) tar xjf "$file" ;;
            *.tar.gz|*.tgz) tar xzf "$file" ;;
            *.tar.xz|*.txz) tar xJf "$file" ;;
            *.tar) tar xf "$file" ;;
            *.bz2) bunzip2 "$file" ;;
            *.gz) gunzip "$file" ;;
            *.zip|*.cbz|*.epub) unzip "$file" ;;
            *.rar|*.cbr) unrar x "$file" ;;
            *.7z|*.cb7) 7z x "$file" ;;
            *.xz) unxz "$file" ;;
            *) echo "Error: '$file' - unknown archive method" ;;
        esac
    done
}

# FZF enhanced functions
# Fuzzy find and edit
fzf_edit() {
    local file
    file=$(fzf --query="$1" --preview 'bat --style=numbers --color=always --line-range :500 {}') && ${EDITOR:-vim} "$file"
}

# Fuzzy find and cd with preview
fzf_cd() {
    local dir
    dir=$(fd --type d | fzf --preview 'eza --tree --color=always --icons {} | head -200') && cd "$dir"
}

# Fuzzy kill process
fzf_kill() {
    local pid
    pid=$(ps -ef | sed 1d | fzf -m --header='[kill:process]' | awk '{print $2}')
    if [[ -n $pid ]]; then
        echo $pid | xargs kill -${1:-9}
    fi
}

# Fuzzy git branch checkout
fzf_git_branch() {
    git branch -a | grep -v HEAD | sed 's/remotes\/origin\///' | sort -u | fzf --header='[git:branch]' | xargs git checkout
}

# Fuzzy history search with execution
fzf_history() {
    local cmd
    cmd=$(history | fzf --tac --no-sort --query="$*" | sed 's/^ *[0-9]* *//')
    if [[ -n $cmd ]]; then
        print -z "$cmd"
    fi
}

# Directory bookmark system
bookmark() {
    echo "$(pwd) : $1" >> ~/.bookmarks
}

goto() {
    local dest
    dest=$(cat ~/.bookmarks 2>/dev/null | fzf --delimiter=' : ' --with-nth=2 --preview='echo "Path: {1}"' | cut -d' ' -f1)
    [[ -n $dest ]] && cd "$dest"
}

# Create widgets for custom functions
