# --------------------------------------------------------------------------- #
#                                 ZSHRC LOADER
# --------------------------------------------------------------------------- #
# core → [macos] → tools → plugins → prompt → help → [full] → .zshrc.local
#   DOTFILES_PROFILE=full (défaut) | lite (déployé par lite/install.sh)
#   Spécificités machine (PATH d'installeurs…) : ${ZDOTDIR:-$HOME}/.zshrc.local

# Répertoire réel de ce fichier (résout le lien ~/.zshrc -> dotfiles/shell/zshrc)
ZSH_CFG_DIR=${${(%):-%x}:A:h}/zsh

# Généré par lite/install.sh (profil, chemin des plugins)
[[ -f "$ZSH_CFG_DIR/profile.zsh" ]] && source "$ZSH_CFG_DIR/profile.zsh"
: ${DOTFILES_PROFILE:=full}

source "$ZSH_CFG_DIR/core.zsh"
[[ $OSTYPE == darwin* && -f "$ZSH_CFG_DIR/macos.zsh" ]] && source "$ZSH_CFG_DIR/macos.zsh"
source "$ZSH_CFG_DIR/tools.zsh"
source "$ZSH_CFG_DIR/plugins.zsh"
source "$ZSH_CFG_DIR/prompt.zsh"
source "$ZSH_CFG_DIR/help.zsh"
[[ $DOTFILES_PROFILE == full && -f "$ZSH_CFG_DIR/full.zsh" ]] && source "$ZSH_CFG_DIR/full.zsh"

[[ -f "${ZDOTDIR:-$HOME}/.zshrc.local" ]] && source "${ZDOTDIR:-$HOME}/.zshrc.local"
