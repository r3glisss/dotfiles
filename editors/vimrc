" --- Indexation projet : indispensable au goto definition inter-fichiers ---
" verible ne résout les symboles hors du fichier courant que s'il trouve un
" 'verible.filelist' à la racine du projet. Aucun glob n'y est accepté : il
" faut lister chaque fichier. On le régénère donc tout seul, et le serveur le
" relit à chaud (aucun redémarrage nécessaire).
function! s:VeribleRoot(file) abort
  let l:dir = fnamemodify(a:file, ':p:h')
  let l:git = finddir('.git', l:dir . ';')
  if !empty(l:git)
    return fnamemodify(l:git, ':p:h:h')
  endif
  let l:fl = findfile('verible.filelist', l:dir . ';')
  return !empty(l:fl) ? fnamemodify(l:fl, ':p:h') : l:dir
endfunction

function! s:VeribleSync(file) abort
  if empty(a:file) || !filereadable(a:file)
    return 0
  endif
  let l:root = s:VeribleRoot(a:file)
  let l:path = l:root . '/verible.filelist'
  " Dans un dépôt git, 'ls-files -co --exclude-standard' voit les fichiers non
  " encore commités et écarte tout seul les artefacts de build gitignorés.
  if isdirectory(l:root . '/.git')
    let l:cmd = printf('git -C %s ls-files -co --exclude-standard'
      \ . ' -- "*.sv" "*.svh" "*.v" "*.vh"', shellescape(l:root))
  else
    let l:cmd = printf('cd %s && find . \( -name "*.sv" -o -name "*.svh"'
      \ . ' -o -name "*.v" -o -name "*.vh" \) | sed "s|^\./||"', shellescape(l:root))
  endif
  let l:new = sort(filter(split(system(l:cmd), "\n"), '!empty(v:val)'))
  " N'écrit que si le contenu change : évite de faire vieillir le mtime et de
  " déclencher des rebuilds fantômes chez les outils qui lisent ce fichier.
  if l:new ==# (filereadable(l:path) ? readfile(l:path) : [])
    return 0
  endif
  call writefile(l:new, l:path)
  " Garde le dépôt propre sans toucher au .gitignore partagé de l'équipe.
  let l:ex = l:root . '/.git/info/exclude'
  if filereadable(l:ex) && index(readfile(l:ex), 'verible.filelist') < 0
    call writefile(['verible.filelist'], l:ex, 'a')
  endif
  return 1
endfunction

command! VeribleFilelist echo s:VeribleSync(expand('%:p'))
  \ ? 'verible.filelist mis a jour' : 'verible.filelist deja a jour'

augroup VeribleProject
