" -----------------------------------------------------------------------------
" Bascule rapide de thème  (xcode <-> claude sombre <-> claude clair)
" -----------------------------------------------------------------------------
" Chaque entrée = colorscheme + background + thème airline assortis.
let s:themes = [
      \ {'name': 'claude-light', 'colors': 'claude',      'bg': 'light', 'airline': 'claude'},
      \ {'name': 'claude-dark',  'colors': 'claude',      'bg': 'dark',  'airline': 'claude'},
      \ {'name': 'xcode',        'colors': 'xcodedarkhc', 'bg': 'dark',  'airline': 'onedark'},
      \ ]
let s:theme_idx = 0

function! s:ThemeNames(...) abort
  return map(copy(s:themes), 'v:val.name')
endfunction

function! s:ThemeApply(name, ...) abort
  let l:i = index(s:ThemeNames(), a:name)
  if l:i < 0
    echohl ErrorMsg | echo 'Thème inconnu : ' . a:name | echohl NONE
    return
  endif
  let l:t = s:themes[l:i]
  let s:theme_idx = l:i
  execute 'set background=' . l:t.bg
  execute 'colorscheme ' . l:t.colors
  if exists(':AirlineTheme') == 2
    execute 'AirlineTheme ' . l:t.airline
  else
    let g:airline_theme = l:t.airline
  endif
  if get(g:, 'theme_persist', 0)
    call writefile([l:t.name], s:vimdir . '/last-theme')
  endif
  " a:1 = silencieux (restauration au démarrage)
  if !a:0
    redraw | echo 'Thème : ' . l:t.name . '  (' . l:t.colors . ' / ' . l:t.bg . ')'
  endif
endfunction

function! s:ThemeCycle() abort
  call s:ThemeApply(s:themes[(s:theme_idx + 1) % len(s:themes)].name)
endfunction

command! -bar ThemeNext call s:ThemeCycle()
command! -bar -nargs=1 -complete=customlist,s:ThemeNames Theme call s:ThemeApply(<q-args>)

