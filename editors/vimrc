" -----------------------------------------------------------------------------
" Répertoires
" -----------------------------------------------------------------------------
" Données (plugins, backup, swap, undo) : ~/.vim, ou $DOTFILES_VIMDIR pour
" rester isolé de la config vim d'un serveur client (profil lite).
let s:vimdir = empty($DOTFILES_VIMDIR) ? expand('~/.vim') : $DOTFILES_VIMDIR
if s:vimdir !=# expand('~/.vim')
  " ~/.vim du client hors du runtimepath : rien de son côté ne se charge
  set runtimepath-=~/.vim runtimepath-=~/.vim/after
  execute 'set runtimepath^=' . fnameescape(s:vimdir)
  execute 'set runtimepath+=' . fnameescape(s:vimdir . '/after')
  if exists('+viminfofile')
    let &viminfofile = s:vimdir . '/viminfo'
  endif
endif
" Thème claude, coloration verilog : editors/vim du dépôt, trouvé via le lien
" ~/.vimrc (ou -u). Ignoré si ~/.vim/colors pointe déjà dessus.
let s:repo_vim = fnamemodify(resolve(expand('<sfile>:p')), ':h') . '/vim'
if isdirectory(s:repo_vim)
  \ && resolve(s:vimdir . '/colors') !=# resolve(s:repo_vim . '/colors')
  execute 'set runtimepath^=' . fnameescape(s:repo_vim)
  execute 'set runtimepath+=' . fnameescape(s:repo_vim . '/after')
endif

" -----------------------------------------------------------------------------
" Auto-install vim-plug and plugins
" -----------------------------------------------------------------------------
if empty(glob(s:vimdir . '/autoload/plug.vim'))
  execute 'silent !curl -fLo ' . shellescape(s:vimdir . '/autoload/plug.vim')
    \ . ' --create-dirs https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim'
endif
